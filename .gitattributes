* text=auto eol=lf
*.osm.pbf binary
*.tif binary
# Godot rejection logs retain their original final blank line.
data/reports/collision/rejections/*.log whitespace=-blank-at-eof
data/reports/daehanmun/rejections/*.log whitespace=-blank-at-eof
data/reports/palace/rejections/*.log whitespace=-blank-at-eof
data/reports/public/rejections/*.log whitespace=-blank-at-eof
data/reports/public/development/pre_idle_fix_rejections/*.log whitespace=-blank-at-eof
data/reports/public/development/pre_guide_winding_fix/rejections/*.log whitespace=-blank-at-eof
# Preserve the N03 engine failure log's original "ERROR: " line.
data/reports/n03/development/smoke02/smoke.log whitespace=-blank-at-eol
# Preserve the unmodified upstream CC0 license, including CRLF and blank tabs.
game/assets/vendor/kenney_city_kit_commercial/License.txt -text -eol whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# R03 command output and unified-diff context are exact-byte evidence.
data/reports/r03/**/*.log -text -eol whitespace=-blank-at-eof
data/reports/r03/exports/**/temporary_project.diff -text -eol whitespace=-blank-at-eol
# EXP20 source and review evidence retain upstream bytes, including CRLF.
data/raw/supplemental/seoul_terrain/20261018/* -text -eol whitespace=cr-at-eol
data/reports/realism_rework/20261017/terrain_sources/kogl-type1-original.html -text -eol whitespace=-blank-at-eol
# A unified diff's context prefix precedes the original GDScript tabs.
data/reports/realism_rework/20261017/development/menu_palette_only.patch -text -eol whitespace=-space-before-tab
# EXP25 raw engine evidence retains its original final blank lines and bytes.
data/reports/urban_transit/20261021/**/*.log -text -eol whitespace=-blank-at-eof
# EXP26 raw engine evidence retains its original final blank lines and bytes.
data/reports/mobility_distribution/20261022/**/*.log -text -eol whitespace=-blank-at-eof

# EXP27 raw engine evidence retains original bytes and final blank lines.
data/reports/city_sandbox/20261022/**/*.log -text -eol whitespace=-blank-at-eof
