	scene.toggle_menu();await _ticks(5);var start_point: Vector3=scene.player.global_position
	Input.action_press("move_forward");await _ticks(14)
	var render_samples:=0;var render_finite:=true;var render_parent:=true;var contact_error:=0.;var max_local_origin_delta:=0.
