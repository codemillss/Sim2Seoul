    source_matches[relative(path)] = {'current': digest(path), 'candidate_snapshot': digest(snapshot), 'match': digest(path) == digest(snapshot)}
check('all_four_authored_builder_sources_match_v03_snapshot', len(source_matches) == 4 and all(r['match'] for r in source_matches.values()) and level_two_contract, {'sources': source_matches, 'same_level_2_support_render_export_contract': level_two_contract, 'manifest_export_subdivision_level': manifest.get('export_subdivision_level'), 'canonical_manifest_matches_candidate': canonical_manifest_matches, 'actual_source_override': level_lines, 'rig_assignment_source_line': assign_line})
baseline_manifest = json.loads(BASELINE_MANIFEST.read_text())
check('original_exp36_v03_baseline_bytes_unchanged', digest(BASELINE) == 'a31f13eddf53b954c954aa2397d7591ed3b065b8d194e8704bb60bece603da7b' and
      digest(BASELINE_MANIFEST) == digest(BASELINE_SOURCE/'FORM_STUDY_MANIFEST.json'),
