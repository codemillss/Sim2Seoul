      body_audit['source_sha256'] == digest(ROOT/body_audit['source_path']) and body_audit['audit_script_sha256'] == digest(BODY_AUDIT.with_name('body_source_audit.py.source')),
      {'body_source_audit': relative(BODY_AUDIT), 'sha256': digest(BODY_AUDIT), 'moved_control_vertices': body_audit['moved_control_vertices'],
       'conditions': body_audit['conditions'], 'scope': body_audit['method']})
selected_disposition = json.loads((CANDIDATE/'disposition.json').read_text())
rejections = [json.loads(p.read_text()) for p in (REJECTION01, REJECTION)]
check('rejected_v01_v02_and_selected_v03_remain_separate_art_unaccepted',
