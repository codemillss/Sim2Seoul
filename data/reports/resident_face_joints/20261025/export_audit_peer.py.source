    correctives_valid &= all(row['supported_control_vertices'][name] > 0 and row['skipped_singular_blends'][name] == 0 for name in caps)
for primitive in primitive_reports:
    correctives_valid &= all(0. < row['maximum_position_delta_m'] <= caps[row['name']]+1e-6 for row in primitive['morphs'])
check('bounded_pose_support_caps_match_manifest_and_actual_morph_deltas', correctives_valid,
      {'caps_m': caps, 'actual_manifest_correctives': corrective_rows, 'actual_binary_morphs': [p['morphs'] for p in primitive_reports],
       'scope': 'Finite bounded authored supports, not acceptance of soft-tissue or muscle realism.'})
supports, support_valid = [], True
for pose in manifest['rig']['diagnostic_poses']:
    support = pose['evaluated_sole_support'];after_support = support['after']
    expected_sides = ['L'] if pose['key'] == 'single_support' else ['L', 'R']
    support_valid &= support['support_sides'] == expected_sides
    for side, row in after_support.items():
        support_valid &= row.get('available') is True and all(row[k] > 0 for k in ('heel_samples', 'toe_samples', 'foot_samples'))
        support_valid &= all(math.isfinite(row[k]) for k in ('minimum_z_m', 'heel_min_z_m', 'toe_min_z_m'))
        if side in expected_sides:
            support_valid &= all(abs(row[k]-support['floor_z_m']) < .001 for k in ('minimum_z_m', 'heel_min_z_m', 'toe_min_z_m'))
        elif pose['key'] == 'single_support':
