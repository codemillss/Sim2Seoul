level_lines = [{'line': i+1, 'text': line.strip()} for i, line in enumerate(builder_lines) if "if modifier.type=='SUBSURF':modifier.levels=2;modifier.render_levels=2" in line]
assign_line = next(i+1 for i, line in enumerate(builder_lines) if 'rig,rig_info=assign_rig(cage,info)' in line)
level_two_contract = manifest.get('export_subdivision_level') == 2 and len(level_lines) == 1 and level_lines[0]['line'] < assign_line and sum(p['vertices'] for p in primitive_reports) == manifest['export_surface_vertices'] and manifest['export_surface_vertices'] > 0 and canonical_manifest_matches
