      {'rejections': [{'file': relative(p), 'sha256': digest(p), 'disposition': r} for p, r in zip((REJECTION01, REJECTION), rejections)],
       'selected_v03': selected_disposition, 'scope': 'Selection is an editable next prototype, not realistic-human or user art acceptance.'})
blend_header = BLEND.read_bytes()[:12]
check('canonical_candidate_file_types_and_manifest_asset_bindings_match', blend_header.startswith(b'BLENDER') and
      all(manifest['files'][p.name]['bytes'] == p.stat().st_size and manifest['files'][p.name]['sha256'] == digest(p) for p in (GLB, BLEND)) and
      all(binding['bytes'] == (ROOT/name).stat().st_size and binding['sha256'] == digest(ROOT/name) for name, binding in selected_disposition['canonical_files'].items()),
      {'blend_header': blend_header.decode('ascii'), 'manifest_asset_files': manifest['files'], 'selected_canonical_files': selected_disposition['canonical_files']})
def stored_finite_observations(path):
    payload = path.read_bytes();offset, items = 12, []
    while offset < len(payload):
        size, kind = struct.unpack_from('<II', payload, offset);offset += 8
        items.append((kind, payload[offset:offset+size]));offset += size
    document, data = json.loads(items[0][1]), items[1][1]
    bad, components = [], 0
    for ai, accessor in enumerate(document['accessors']):
        parts = []
        if 'bufferView' in accessor:
            parts.append((accessor['bufferView'], accessor.get('byteOffset', 0), accessor['count'], 'base'))
        if 'sparse' in accessor:
            sparse = accessor['sparse'];part = sparse['values']
            parts.append((part['bufferView'], part.get('byteOffset', 0), sparse['count'], 'sparse_values'))
        fmt, size = COMPONENTS[accessor['componentType']];elements, packed = layout(accessor['type'], size)
        for vi, local, count, kind in parts:
            view = document['bufferViews'][vi];start = view.get('byteOffset', 0)+local;stride = view.get('byteStride', packed)
            if local+(count-1)*stride+packed > view['byteLength']:
                raise ValueError('Historical accessor out of bounds')
            for i in range(count):
                values = [struct.unpack_from('<'+fmt, data, start+i*stride+e)[0] for e in elements];components += len(values)
                if not all(math.isfinite(v) for v in values):
                    bad.append({'accessor': ai, 'part': kind, 'element': i, 'values': values})
    return {'file': relative(path), 'sha256': digest(path), 'accessors': len(document['accessors']), 'decoded_stored_components': components,
            'nonfinite_components_detected': len(bad), 'examples': bad[:5]}
warning_observations, warning_binary = [], []
for version in ('v01', 'v02', 'v03'):
    log = Path(__file__).parent/'candidates'/version/'build.log';lines = log.read_text(errors='replace').splitlines()
    warnings = [{'line': i+1, 'text': line} for i, line in enumerate(lines) if 'RuntimeWarning:' in line]
    warning_observations.append({'candidate': version, 'log': relative(log), 'sha256': digest(log), 'runtime_warning_count': len(warnings), 'warnings': warnings})
    warning_binary.append(stored_finite_observations(log.with_name('resident_form_m01.glb')))
check('warning_bearing_builds_have_no_nonfinite_stored_accessor_values', all(r['nonfinite_components_detected'] == 0 for r in warning_binary),
