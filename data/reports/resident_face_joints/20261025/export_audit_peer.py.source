current_rig_tree = ast.parse((ROOT/'tools/sculpted_character/build_study_rig.py').read_text())
baseline_rig_tree = ast.parse((BASELINE_SOURCE/'source/build_study_rig.py').read_text())
def function_ast(tree, name):
    return ast.dump(next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == name), include_attributes=False)
restored = {name: function_ast(current_rig_tree, name) == function_ast(baseline_rig_tree, name)
            for name in ('_weights', '_bone_specs', '_leg_to', '_fit_support', 'apply_study_pose')}
check('bone_pose_attachment_and_support_rules_preserved_from_frozen_exp36', all(restored.values()),
      {'functions_ast_equal': restored, 'scope': 'Only comments are excluded. Corrective construction and new authored geometry differ; base attachment/pose/rest/support rules are unchanged.'})
def multiply(a, b):
    return [[sum(a[r][k]*b[k][c] for k in range(4)) for c in range(4)] for r in range(4)]
def node_matrix(node):
    if 'matrix' in node:
        return [[node['matrix'][c*4+r] for c in range(4)] for r in range(4)]
    x, y, z, w = node.get('rotation', [0., 0., 0., 1.]);sx, sy, sz = node.get('scale', [1., 1., 1.]);tx, ty, tz = node.get('translation', [0., 0., 0.])
    return [[(1-2*y*y-2*z*z)*sx, (2*x*y-2*z*w)*sy, (2*x*z+2*y*w)*sz, tx],
            [(2*x*y+2*z*w)*sx, (1-2*x*x-2*z*z)*sy, (2*y*z-2*x*w)*sz, ty],
            [(2*x*z-2*y*w)*sx, (2*y*z+2*x*w)*sy, (1-2*x*x-2*y*y)*sz, tz], [0., 0., 0., 1.]]
parent_nodes = {child: i for i, node in enumerate(nodes) for child in node.get('children', [])}
rest_global = {}
def global_rest(i):
    if i not in rest_global:
        local = node_matrix(nodes[i]);rest_global[i] = multiply(global_rest(parent_nodes[i]), local) if i in parent_nodes else local
    return rest_global[i]
baseline_bones = {b['name']: b for b in baseline_manifest['rig']['bones']}
manifest_bones = {b['name']: b for b in manifest['rig']['bones']}
rest_rows = []
for node_id, name in zip(joint_nodes, bone_names):
    actual = [global_rest(node_id)[r][3] for r in range(3)];head = manifest_bones[name]['head_m'];expected = [head[0], head[2], -head[1]]
    error = math.sqrt(sum((a-b)**2 for a, b in zip(actual, expected)))
    old = baseline_bones[name];same_rest = all(abs(manifest_bones[name][field][i]-old[field][i]) < 1e-7 for field in ('head_m', 'tail_m') for i in range(3))
    rest_rows.append({'name': name, 'actual_glb_rest_head_yup_m': actual, 'manifest_head_yup_m': expected, 'error_m': error, 'same_head_tail_as_baseline': same_rest})
check('actual_binary_rest_heads_match_manifest_and_original_bone_lengths', len(rest_rows) == 22 and all(r['error_m'] < .0001 and r['same_head_tail_as_baseline'] for r in rest_rows),
      {'maximum_actual_rest_head_error_m': max(r['error_m'] for r in rest_rows), 'joints': rest_rows})
declared_limits = []
for i, accessor in enumerate(accessors):
    if accessor['componentType'] != 5126 or ('min' not in accessor and 'max' not in accessor):
        continue
    rows = read(i)
    for field, reducer in (('min', min), ('max', max)):
        if field not in accessor:
            continue
        actual = [reducer(row[k] for row in rows) for k in range(len(rows[0]))]
        expected = accessor[field]
        declared_limits.append({'accessor': i, 'field': field, 'actual': actual, 'declared': expected,
                                'match': len(actual) == len(expected) and all(math.isfinite(x) and abs(a-x) <= 1e-6*max(1., abs(x)) for a, x in zip(actual, expected))})
check('actual_decoded_float_accessor_extents_match_declared_min_max', bool(declared_limits) and all(r['match'] for r in declared_limits),
      {'checked_limits': len(declared_limits), 'limits': declared_limits})
mesh_bind = global_rest(mesh_nodes[0]);binding_errors = []
for node_id, name, raw_matrix in zip(joint_nodes, bone_names, inverse_bind):
    matrix = [[raw_matrix[c*4+r] for c in range(4)] for r in range(4)]
    product = multiply(global_rest(node_id), matrix)
    error = max(abs(product[r][c]-mesh_bind[r][c]) for r in range(4) for c in range(4))
    binding_errors.append({'bone': name, 'maximum_component_error': error})
check('all_actual_inverse_bind_matrices_reconstruct_mesh_rest_binding', len(binding_errors) == 22 and
      all(math.isfinite(r['maximum_component_error']) and r['maximum_component_error'] < 1e-4 for r in binding_errors), binding_errors)
endpoint_rows, triangle_observations = [], []
for mesh in meshes:
    for primitive in mesh['primitives']:
        positions = read(primitive['attributes']['POSITION']);normals = read(primitive['attributes']['NORMAL'])
        for i, target in enumerate(primitive['targets']):
            delta_positions, delta_normals = read(target['POSITION']), read(target['NORMAL'])
            lengths = [math.sqrt(sum((a+b)**2 for a, b in zip(n, d))) for n, d in zip(normals, delta_normals)]
            endpoint_rows.append({'name': EXPECTED_MORPHS[i], 'minimum_unrenormalized_normal_length': min(lengths),
                                  'maximum_unrenormalized_normal_length': max(lengths),
                                  'all_positions_finite': all(math.isfinite(a+b) for p, d in zip(positions, delta_positions) for a, b in zip(p, d))})
        indices = [row[0] for row in read(primitive['indices'])];areas = []
        for i in range(0, len(indices), 3):
            a, b, c = (positions[indices[i+k]] for k in range(3))
            u = [b[k]-a[k] for k in range(3)];v = [c[k]-a[k] for k in range(3)]
            cross = [u[1]*v[2]-u[2]*v[1], u[2]*v[0]-u[0]*v[2], u[0]*v[1]-u[1]*v[0]]
            areas.append(.5*math.sqrt(sum(x*x for x in cross)))
        triangle_observations.append({'triangles': len(areas), 'minimum_area_m2': min(areas), 'maximum_area_m2': max(areas),
                                      'exact_zero_area_count': sum(a == 0. for a in areas), 'area_below_1e_16_m2_count': sum(a < 1e-16 for a in areas),
                                      'scope': 'Binary geometric observation only; no exporter warning root cause is inferred from this count.'})
check('full_weight_morph_endpoints_have_finite_positions_and_nonzero_normals', len(endpoint_rows) == 3 and
      all(r['all_positions_finite'] and math.isfinite(r['minimum_unrenormalized_normal_length']) and r['minimum_unrenormalized_normal_length'] > 1e-6 for r in endpoint_rows), endpoint_rows)
relief_rows, relief_valid = [], True
for row in corrective_rows:
    for name, relief in row['fold_relief'].items():
        value = relief['maximum_posed_relief_m']
        valid = math.isfinite(value) and 0. <= value <= .0025+1e-7
        valid &= relief['actually_adjusted_vertices'] <= relief['masked_vertices']
        if name == EXPECTED_MORPHS[2]:
            valid &= relief['masked_vertices'] == relief['actually_adjusted_vertices'] == 0 and value == 0.
        else:
            valid &= relief['masked_vertices'] > 0 and len(relief['selected_strips']) == 2
        for strip in relief['selected_strips']:
            valid &= bool(strip['core_vertex_ids']) and all(0 <= i < topology['control_vertices'] for i in strip['core_vertex_ids'])
        for example in relief['largest_examples']:
            vector = example['posed_relief_world_m'];length = math.sqrt(sum(v*v for v in vector))
            valid &= all(math.isfinite(v) for v in vector) and abs(length-example['posed_relief_length_m']) < 1e-7 and length <= .0025*example['mask']+1e-7
            if name == EXPECTED_MORPHS[1]:
                valid &= abs(example['rest_world_m'][0]) >= .040-1e-7
        relief_valid &= valid
        relief_rows.append({'name': name, 'masked_vertices': relief['masked_vertices'], 'actually_adjusted_vertices': relief['actually_adjusted_vertices'],
                            'maximum_posed_relief_m': value, 'valid_local_cap': bool(valid), 'selected_strips': relief['selected_strips']})
check('recorded_local_fold_relief_stays_in_semantic_strips_and_2_5mm_cap', relief_valid,
      {'observations': relief_rows, 'floating_point_tolerance_m': 1e-7,
       'scope': 'Recorded actual Blender corrective evaluation; current BIN independently verifies total morph bounds. This does not prove anatomical or art quality.'})
body_audit = json.loads(BODY_AUDIT.read_text())
def all_true(value):
    return all(all_true(v) for v in value.values()) if isinstance(value, dict) else value is True
check('body_source_109_vertex_edit_preserves_declared_topology_and_joins', body_audit['moved_control_vertices'] == len(body_audit['moved_vertices']) == 109 and
