; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sim2Seoul E01 Engine Check"
run/main_scene="res://startup.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=960
window/size/viewport_height=600
window/size/window_width_override=960
window/size/window_height_override=600
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method.mobile="forward_plus"
rendering_device/driver.macos="metal"
environment/defaults/default_clear_color=Color(0.06, 0.09, 0.13, 1)
